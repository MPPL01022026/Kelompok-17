# Konfigurasi Docker Compose (Produksi) — Salin ke .env di root repo sebelum menjalankan:
# cp .env.example .env && docker compose up -d --build

APP_NAME="Ayamo - Eat, Chill, Repeat"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_PORT=8000
# Isi dengan output `php artisan key:generate --show` (jika kosong, entrypoint akan membuat fallback otomatis)
APP_KEY=

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database & Container MySQL 8.4
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_BIND_HOST=127.0.0.1
DB_DATABASE=ayamo_db
DB_USERNAME=ayamo_user
DB_PASSWORD=ayamo_secret
MYSQL_ROOT_PASSWORD=ayamo_root_secret

# Otomatisasi saat container menyala
AUTORUN_MIGRATIONS=true
AUTORUN_SEED=false

# Kredensial Panel Admin (jika hash bcrypt memakai $, gunakan kutip tunggal '...' atau escape $$ di Compose)
ADMIN_USERNAME=adminayamo
ADMIN_PASSWORD_HASH=

# Runtime Drivers
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Opsional: jalankan dengan `docker compose --profile tunnel up -d`
CLOUDFLARED_TUNNEL_TOKEN=
